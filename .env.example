# Google Analytics 4 — Measurement ID from GA4 Admin → Data streams → your stream
# Copy to .env locally. For GitHub Pages CI, set the same name as a repository secret.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase — Project Settings → API. The anon/public key is safe to expose
# client-side; access is restricted by RLS policies set up via the SQL
# scripts in supabase/. Powers a couple of unlisted pages — see
# NOTES.private.md for details. Also set both as repo secrets for
# GitHub Actions (used by the deploy and supabase-keepalive workflows).
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
