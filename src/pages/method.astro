---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Martin Makaveev"
  description="A shared clipboard. What's here is visible to anyone with the link."
  noindex
>
  <main class="min-h-screen flex items-center justify-center px-6 py-24">
    <div class="w-full max-w-2xl lg:max-w-5xl mx-auto">
      <div class="mb-8 text-center">
        <p class="section-label mb-3">Shared Clipboard</p>
        <p class="text-sm text-text-muted">
          One shared slot. Anyone with this link can see it, copy it, delete it,
          or overwrite it with something new.
        </p>
        <a
          href="#file-section"
          class="inline-block mt-4 font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-border text-text-secondary hover:text-text-primary hover:border-text-secondary transition-colors"
        >
          ↓ Jump to file upload
        </a>
      </div>

      <div
        id="config-warning"
        class="hidden mb-6 border border-red-guards-dim bg-red-guards-dim/10 text-text-secondary text-sm p-4 font-mono"
      >
        Supabase isn't configured — set <code>PUBLIC_SUPABASE_URL</code> and
        <code>PUBLIC_SUPABASE_ANON_KEY</code> to enable this page.
      </div>

      <div class="flex flex-col lg:flex-row lg:items-start gap-8">
      <div class="w-full lg:max-w-2xl">

      <!-- Current content -->
      <section
        id="current-panel"
        class="border border-border bg-surface p-5 mb-6"
      >
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-2xs tracking-widest uppercase text-text-muted"
            >Currently pasted</span
          >
          <span id="updated-at" class="font-mono text-2xs text-text-muted"></span>
        </div>

        <div id="empty-state" class="text-text-muted text-sm py-8 text-center">
          Loading…
        </div>

        <pre
          id="text-view"
          class="hidden whitespace-pre-wrap break-words font-mono text-sm text-text-primary bg-surface-2 border border-border p-4 max-h-96 overflow-auto"></pre>

        <div id="image-view" class="hidden">
          <img
            id="image-el"
            class="max-w-full max-h-96 mx-auto border border-border"
            alt="Pasted content"
          />
        </div>

        <div id="action-row" class="hidden mt-4 flex flex-wrap gap-3">
          <button
            id="copy-btn"
            type="button"
            class="font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-border text-text-secondary hover:text-text-primary hover:border-text-secondary transition-colors"
          >
            Copy
          </button>
          <button
            id="delete-btn"
            type="button"
            class="font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-red-guards-dim text-red-guards hover:bg-red-guards-dim/10 transition-colors"
          >
            Delete
          </button>
        </div>
      </section>

      <!-- Paste new content -->
      <section class="border border-border bg-surface p-5">
        <span
          class="font-mono text-2xs tracking-widest uppercase text-text-muted block mb-3"
          >Paste something new</span
        >

        <textarea
          id="text-input"
          rows="5"
          placeholder="Type or paste text/code here — or paste (Ctrl/Cmd+V) an image directly"
          class="w-full bg-surface-2 border border-border text-text-primary font-mono text-sm p-3 resize-y focus:outline-none focus:border-red-guards-dim placeholder:text-text-muted"
        ></textarea>

        <div class="flex flex-wrap items-center gap-3 mt-3">
          <button
            id="save-text-btn"
            type="button"
            class="font-mono text-2xs tracking-widest uppercase px-4 py-2 bg-red-guards text-white hover:bg-red-guards-glow transition-colors"
          >
            Save text
          </button>

          <span class="text-text-muted text-2xs font-mono">or</span>

          <label
            class="font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-border text-text-secondary hover:text-text-primary hover:border-text-secondary transition-colors cursor-pointer"
          >
            Choose image
            <input id="file-input" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" />
          </label>
        </div>

        <p id="status-msg" class="mt-3 text-2xs font-mono text-text-muted min-h-[1em]"></p>
      </section>

      </div>

      <aside id="history-panel" class="w-full lg:w-64 lg:shrink-0 lg:sticky lg:top-8">
        <span class="font-mono text-2xs tracking-widest uppercase text-text-muted block mb-3">History</span>
        <div class="border border-border bg-surface p-3">
          <div id="history-empty" class="text-text-muted text-2xs font-mono py-4 text-center">
            No history yet.
          </div>
          <ul id="history-list" class="flex flex-col gap-2"></ul>
        </div>
      </aside>

      </div>

      <dialog id="history-modal" class="modal-dialog">
        <div class="modal-panel bg-surface border border-border text-text-primary w-full max-w-2xl max-h-[85vh] flex flex-col">
          <div class="flex items-center justify-between gap-4 p-6 border-b border-border shrink-0">
            <span id="history-modal-time" class="font-mono text-2xs text-text-muted"></span>
            <button
              data-close-modal
              type="button"
              class="shrink-0 text-text-muted hover:text-text-primary transition-colors p-1"
              aria-label="Close"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
              </svg>
            </button>
          </div>

          <div class="overflow-y-auto flex-1 p-6">
            <pre
              id="history-modal-text"
              class="hidden whitespace-pre-wrap break-words font-mono text-sm text-text-primary bg-surface-2 border border-border p-4"></pre>
            <div id="history-modal-image" class="hidden">
              <img
                id="history-modal-image-el"
                class="max-w-full max-h-96 mx-auto border border-border"
                alt="Pasted content"
              />
            </div>
          </div>

          <div class="flex items-center justify-between gap-3 p-6 border-t border-border shrink-0">
            <p id="history-modal-status" class="text-2xs font-mono text-text-muted min-h-[1em]"></p>
            <button
              id="history-modal-copy-btn"
              type="button"
              class="font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-border text-text-secondary hover:text-text-primary hover:border-text-secondary transition-colors"
            >
              Copy
            </button>
          </div>
        </div>
      </dialog>

      <div id="file-section" class="scroll-mt-8 mt-16">
        <div class="mb-8 text-center">
          <p class="section-label mb-3">File Upload</p>
          <p class="text-sm text-text-muted">
            Same idea, but for files. One shared slot — upload something,
            anyone with this link can download it.
          </p>
        </div>

        <!-- Current file -->
        <section
          id="file-current-panel"
          class="border border-border bg-surface p-5 mb-6"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-2xs tracking-widest uppercase text-text-muted"
              >Currently uploaded</span
            >
            <span id="file-updated-at" class="font-mono text-2xs text-text-muted"></span>
          </div>

          <div id="file-empty-state" class="text-text-muted text-sm py-8 text-center">
            Loading…
          </div>

          <div id="file-view" class="hidden flex items-center justify-between gap-3 bg-surface-2 border border-border p-4">
            <div class="min-w-0">
              <p id="file-name" class="font-mono text-sm text-text-primary truncate"></p>
              <p id="file-size" class="font-mono text-2xs text-text-muted"></p>
            </div>
          </div>

          <div id="file-action-row" class="hidden mt-4 flex flex-wrap gap-3">
            <button
              id="file-download-btn"
              type="button"
              class="font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-border text-text-secondary hover:text-text-primary hover:border-text-secondary transition-colors"
            >
              Download
            </button>
            <button
              id="file-delete-btn"
              type="button"
              class="font-mono text-2xs tracking-widest uppercase px-4 py-2 border border-red-guards-dim text-red-guards hover:bg-red-guards-dim/10 transition-colors"
            >
              Delete
            </button>
          </div>
        </section>

        <!-- Upload new file -->
        <section class="border border-border bg-surface p-5">
          <span
            class="font-mono text-2xs tracking-widest uppercase text-text-muted block mb-3"
            >Upload something new</span
          >

          <label
            id="file-drop-zone"
            class="flex flex-col items-center justify-center gap-2 border border-dashed border-border bg-surface-2 p-8 text-center cursor-pointer hover:border-text-secondary transition-colors"
          >
            <span class="text-text-secondary text-sm">Drop a file here, or click to choose one</span>
            <span class="text-text-muted text-2xs font-mono">Max 20MB · any file type</span>
            <input id="file-upload-input" type="file" class="hidden" />
          </label>

          <p id="file-status-msg" class="mt-3 text-2xs font-mono text-text-muted min-h-[1em]"></p>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase, supabaseConfigured } from '../lib/supabase';

  const ROW_ID = 1;
  const BUCKET = 'secret-uploads';
  const OBJECT_PATH = 'current';
  const MAX_TEXT_LENGTH = 5_000_000;
  const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
  const ALLOWED_IMAGE_TYPES = ['image/png', 'image/jpeg', 'image/gif', 'image/webp'];

  const FILE_BUCKET = 'secret-files';
  const FILE_OBJECT_PATH = 'current';
  const MAX_FILE_BYTES = 20 * 1024 * 1024;

  const HISTORY_TABLE = 'paste_history';
  const HISTORY_LIMIT = 5;
  const HISTORY_IMAGE_PREFIX = 'history/';

  const $ = (id: string) => document.getElementById(id)!;

  const configWarning = $('config-warning');
  const emptyState = $('empty-state');
  const textView = $('text-view') as HTMLPreElement;
  const imageView = $('image-view');
  const imageEl = $('image-el') as HTMLImageElement;
  const actionRow = $('action-row');
  const updatedAtEl = $('updated-at');
  const copyBtn = $('copy-btn') as HTMLButtonElement;
  const deleteBtn = $('delete-btn') as HTMLButtonElement;
  const textInput = $('text-input') as HTMLTextAreaElement;
  const saveTextBtn = $('save-text-btn') as HTMLButtonElement;
  const fileInput = $('file-input') as HTMLInputElement;
  const statusMsg = $('status-msg');

  const fileEmptyState = $('file-empty-state');
  const fileView = $('file-view');
  const fileNameEl = $('file-name');
  const fileSizeEl = $('file-size');
  const fileActionRow = $('file-action-row');
  const fileUpdatedAtEl = $('file-updated-at');
  const fileDownloadBtn = $('file-download-btn') as HTMLButtonElement;
  const fileDeleteBtn = $('file-delete-btn') as HTMLButtonElement;
  const fileDropZone = $('file-drop-zone');
  const fileUploadInput = $('file-upload-input') as HTMLInputElement;
  const fileStatusMsg = $('file-status-msg');

  const historyEmpty = $('history-empty');
  const historyList = $('history-list') as HTMLUListElement;
  const historyModal = $('history-modal') as HTMLDialogElement;
  const historyModalTime = $('history-modal-time');
  const historyModalText = $('history-modal-text') as HTMLPreElement;
  const historyModalImage = $('history-modal-image');
  const historyModalImageEl = $('history-modal-image-el') as HTMLImageElement;
  const historyModalStatus = $('history-modal-status');
  const historyModalCopyBtn = $('history-modal-copy-btn') as HTMLButtonElement;

  type Row = {
    id: number;
    content_type: 'text' | 'image' | null;
    content: string | null;
    image_mime: string | null;
    updated_at: string | null;
  };

  type FileRow = {
    id: number;
    file_name: string | null;
    file_mime: string | null;
    file_size: number | null;
    updated_at: string | null;
  };

  type HistoryRow = {
    id: number;
    content_type: 'text' | 'image';
    content: string | null;
    image_path: string | null;
    image_mime: string | null;
    created_at: string;
  };

  let current: Row | null = null;
  let currentFile: FileRow | null = null;
  let historyItems: HistoryRow[] = [];
  let activeHistoryItem: HistoryRow | null = null;

  function setStatus(msg: string, isError = false) {
    statusMsg.textContent = msg;
    statusMsg.classList.toggle('text-red-guards', isError);
    statusMsg.classList.toggle('text-text-muted', !isError);
  }

  function setBusy(busy: boolean) {
    [saveTextBtn, copyBtn, deleteBtn, fileInput].forEach((el) => {
      (el as HTMLButtonElement | HTMLInputElement).disabled = busy;
    });
  }

  function publicImageUrl(updatedAt: string | null) {
    const { data } = supabase!.storage.from(BUCKET).getPublicUrl(OBJECT_PATH);
    const bust = updatedAt ? `?t=${encodeURIComponent(updatedAt)}` : '';
    return `${data.publicUrl}${bust}`;
  }

  function setFileStatus(msg: string, isError = false) {
    fileStatusMsg.textContent = msg;
    fileStatusMsg.classList.toggle('text-red-guards', isError);
    fileStatusMsg.classList.toggle('text-text-muted', !isError);
  }

  function setFileBusy(busy: boolean) {
    [fileDownloadBtn, fileDeleteBtn, fileUploadInput].forEach((el) => {
      (el as HTMLButtonElement | HTMLInputElement).disabled = busy;
    });
  }

  function formatBytes(bytes: number) {
    if (bytes < 1024) return `${bytes} B`;
    const units = ['KB', 'MB', 'GB'];
    let value = bytes / 1024;
    let unitIndex = 0;
    while (value >= 1024 && unitIndex < units.length - 1) {
      value /= 1024;
      unitIndex += 1;
    }
    return `${value.toFixed(1)} ${units[unitIndex]}`;
  }

  function publicFileUrl(updatedAt: string | null) {
    const { data } = supabase!.storage.from(FILE_BUCKET).getPublicUrl(FILE_OBJECT_PATH);
    const bust = updatedAt ? `?t=${encodeURIComponent(updatedAt)}` : '';
    return `${data.publicUrl}${bust}`;
  }

  function render(row: Row) {
    current = row;
    const hasContent = row.content_type === 'text' || row.content_type === 'image';

    emptyState.classList.toggle('hidden', hasContent);
    textView.classList.add('hidden');
    imageView.classList.add('hidden');
    actionRow.classList.toggle('hidden', !hasContent);

    if (!hasContent) {
      emptyState.textContent = 'Nothing here yet — be the first to paste something.';
      updatedAtEl.textContent = '';
      return;
    }

    updatedAtEl.textContent = row.updated_at
      ? new Date(row.updated_at).toLocaleString()
      : '';

    if (row.content_type === 'text') {
      textView.textContent = row.content ?? '';
      textView.classList.remove('hidden');
    } else if (row.content_type === 'image') {
      imageEl.src = publicImageUrl(row.updated_at);
      imageView.classList.remove('hidden');
    }
  }

  async function loadCurrent() {
    const { data, error } = await supabase!
      .from('secret_paste')
      .select('id, content_type, content, image_mime, updated_at')
      .eq('id', ROW_ID)
      .single();

    if (error) {
      setStatus(`Couldn't load: ${error.message}`, true);
      return;
    }
    render(data as Row);
  }

  function renderFile(row: FileRow) {
    currentFile = row;
    const hasFile = Boolean(row.file_name);

    fileEmptyState.classList.toggle('hidden', hasFile);
    fileView.classList.toggle('hidden', !hasFile);
    fileActionRow.classList.toggle('hidden', !hasFile);

    if (!hasFile) {
      fileEmptyState.textContent = 'Nothing here yet — be the first to upload something.';
      fileUpdatedAtEl.textContent = '';
      return;
    }

    fileNameEl.textContent = row.file_name;
    fileSizeEl.textContent = row.file_size != null ? formatBytes(row.file_size) : '';
    fileUpdatedAtEl.textContent = row.updated_at
      ? new Date(row.updated_at).toLocaleString()
      : '';
  }

  async function loadCurrentFile() {
    const { data, error } = await supabase!
      .from('secret_file')
      .select('id, file_name, file_mime, file_size, updated_at')
      .eq('id', ROW_ID)
      .single();

    if (error) {
      setFileStatus(`Couldn't load: ${error.message}`, true);
      return;
    }
    renderFile(data as FileRow);
  }

  async function uploadFile(file: File) {
    if (file.size > MAX_FILE_BYTES) {
      setFileStatus(`Too large — max ${MAX_FILE_BYTES / 1024 / 1024}MB.`, true);
      return;
    }
    setFileBusy(true);
    setFileStatus('Uploading…');

    const { error: uploadError } = await supabase!.storage
      .from(FILE_BUCKET)
      .upload(FILE_OBJECT_PATH, file, {
        upsert: true,
        contentType: file.type || 'application/octet-stream',
      });

    if (uploadError) {
      setFileBusy(false);
      setFileStatus(`Upload failed: ${uploadError.message}`, true);
      return;
    }

    const { error } = await supabase!
      .from('secret_file')
      .update({
        file_name: file.name,
        file_mime: file.type || 'application/octet-stream',
        file_size: file.size,
        updated_at: new Date().toISOString(),
      })
      .eq('id', ROW_ID);

    setFileBusy(false);
    if (error) {
      setFileStatus(`Save failed: ${error.message}`, true);
      return;
    }
    fileUploadInput.value = '';
    setFileStatus('Uploaded.');
    await loadCurrentFile();
  }

  async function downloadCurrentFile() {
    if (!currentFile?.file_name) return;
    setFileBusy(true);
    setFileStatus('Fetching…');
    try {
      const res = await fetch(publicFileUrl(currentFile.updated_at));
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = currentFile.file_name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      setFileStatus('Downloaded.');
    } catch {
      setFileStatus('Download failed.', true);
    }
    setFileBusy(false);
  }

  async function clearCurrentFile() {
    setFileBusy(true);
    const { error } = await supabase!
      .from('secret_file')
      .update({ file_name: null, file_mime: null, file_size: null, updated_at: new Date().toISOString() })
      .eq('id', ROW_ID);
    setFileBusy(false);
    if (error) {
      setFileStatus(`Delete failed: ${error.message}`, true);
      return;
    }
    setFileStatus('Cleared.');
    await loadCurrentFile();
  }

  async function saveText(text: string) {
    if (!text.trim()) {
      setStatus('Nothing to save.', true);
      return;
    }
    if (text.length > MAX_TEXT_LENGTH) {
      setStatus(`Too long — max ${MAX_TEXT_LENGTH.toLocaleString()} characters.`, true);
      return;
    }
    setBusy(true);
    setStatus('Saving…');
    const { error } = await supabase!
      .from('secret_paste')
      .update({
        content_type: 'text',
        content: text,
        image_mime: null,
        updated_at: new Date().toISOString(),
      })
      .eq('id', ROW_ID);
    setBusy(false);
    if (error) {
      setStatus(`Save failed: ${error.message}`, true);
      return;
    }
    textInput.value = '';
    setStatus('Saved.');
    await loadCurrent();
    void insertHistory({ content_type: 'text', content: text });
  }

  async function saveImage(file: File) {
    if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {
      setStatus('Unsupported image type.', true);
      return;
    }
    if (file.size > MAX_IMAGE_BYTES) {
      setStatus(`Image too large — max ${MAX_IMAGE_BYTES / 1024 / 1024}MB.`, true);
      return;
    }
    setBusy(true);
    setStatus('Uploading…');

    const { error: uploadError } = await supabase!.storage
      .from(BUCKET)
      .upload(OBJECT_PATH, file, { upsert: true, contentType: file.type });

    if (uploadError) {
      setBusy(false);
      setStatus(`Upload failed: ${uploadError.message}`, true);
      return;
    }

    const { error } = await supabase!
      .from('secret_paste')
      .update({
        content_type: 'image',
        content: null,
        image_mime: file.type,
        updated_at: new Date().toISOString(),
      })
      .eq('id', ROW_ID);

    setBusy(false);
    if (error) {
      setStatus(`Save failed: ${error.message}`, true);
      return;
    }
    fileInput.value = '';
    setStatus('Saved.');
    await loadCurrent();
    void insertHistory({ content_type: 'image', file });
  }

  async function clearCurrent() {
    setBusy(true);
    const { error } = await supabase!
      .from('secret_paste')
      .update({ content_type: null, content: null, image_mime: null, updated_at: new Date().toISOString() })
      .eq('id', ROW_ID);
    setBusy(false);
    if (error) {
      setStatus(`Delete failed: ${error.message}`, true);
      return;
    }
    setStatus('Cleared.');
    await loadCurrent();
  }

  async function copyEntry(
    contentType: 'text' | 'image' | null,
    text: string | null,
    imageSrc: string,
    onStatus: (msg: string, isError?: boolean) => void
  ) {
    try {
      if (contentType === 'text') {
        await navigator.clipboard.writeText(text ?? '');
      } else if (contentType === 'image') {
        const res = await fetch(imageSrc);
        const blob = await res.blob();
        await navigator.clipboard.write([new ClipboardItem({ [blob.type]: blob })]);
      }
      onStatus('Copied.');
    } catch {
      onStatus('Copy not supported in this browser — right-click to copy manually.', true);
    }
  }

  async function copyCurrent() {
    if (!current) return;
    await copyEntry(current.content_type, current.content, imageEl.src, setStatus);
  }

  function historyImageUrl(path: string) {
    const { data } = supabase!.storage.from(BUCKET).getPublicUrl(path);
    return data.publicUrl;
  }

  function formatHistoryTime(iso: string) {
    return new Date(iso).toLocaleString();
  }

  function setHistoryModalStatus(msg: string, isError = false) {
    historyModalStatus.textContent = msg;
    historyModalStatus.classList.toggle('text-red-guards', isError);
    historyModalStatus.classList.toggle('text-text-muted', !isError);
  }

  function renderHistory() {
    historyEmpty.classList.toggle('hidden', historyItems.length > 0);
    historyList.innerHTML = '';

    for (const item of historyItems) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'w-full text-left border border-border bg-surface-2 hover:border-text-secondary transition-colors p-2';

      if (item.content_type === 'image' && item.image_path) {
        const img = document.createElement('img');
        img.src = historyImageUrl(item.image_path);
        img.alt = 'Pasted image';
        img.className = 'w-full h-14 object-cover border border-border';
        btn.appendChild(img);
      } else {
        const preview = document.createElement('span');
        preview.className = 'block truncate font-mono text-2xs text-text-secondary';
        preview.textContent = (item.content ?? '').slice(0, 80) || '(empty)';
        btn.appendChild(preview);
      }

      const time = document.createElement('span');
      time.className = 'block font-mono text-2xs text-text-muted mt-1';
      time.textContent = formatHistoryTime(item.created_at);
      btn.appendChild(time);

      btn.addEventListener('click', () => openHistoryItem(item));

      const li = document.createElement('li');
      li.appendChild(btn);
      historyList.appendChild(li);
    }
  }

  async function loadHistory() {
    const { data, error } = await supabase!
      .from(HISTORY_TABLE)
      .select('id, content_type, content, image_path, image_mime, created_at')
      .order('id', { ascending: false })
      .limit(HISTORY_LIMIT);

    if (error) {
      console.error('Could not load history:', error.message);
      return;
    }
    historyItems = (data ?? []) as HistoryRow[];
    renderHistory();
  }

  function openHistoryItem(item: HistoryRow) {
    activeHistoryItem = item;
    setHistoryModalStatus('');
    historyModalTime.textContent = formatHistoryTime(item.created_at);

    historyModalText.classList.add('hidden');
    historyModalImage.classList.add('hidden');

    if (item.content_type === 'text') {
      historyModalText.textContent = item.content ?? '';
      historyModalText.classList.remove('hidden');
    } else if (item.content_type === 'image' && item.image_path) {
      historyModalImageEl.src = historyImageUrl(item.image_path);
      historyModalImage.classList.remove('hidden');
    }

    historyModal.showModal();
  }

  // Best-effort heuristic: Supabase doesn't reliably document exact wording
  // for a project-wide storage/DB quota error, so this matches on common
  // signals (413/507 status, or quota-ish wording) rather than an exact
  // error shape. Deliberately conservative — an error that doesn't look
  // capacity-related is surfaced as-is rather than evicting history for
  // what might be an unrelated/transient failure.
  function isQuotaLikeError(error: unknown): boolean {
    if (!error || typeof error !== 'object') return false;
    const e = error as { status?: number; statusCode?: string | number; message?: string };
    const status = Number(e.statusCode ?? e.status);
    if (status === 413 || status === 507) return true;
    const message = (e.message ?? '').toLowerCase();
    return ['storage', 'quota', 'limit', 'insufficient', 'full'].some((kw) => message.includes(kw));
  }

  // Storage object removed before the DB row: if the row delete then fails,
  // the result is a harmless dangling row that self-heals on the next
  // prune pass, rather than a row pointing at a now-missing image.
  async function evictOldestHistoryItem(): Promise<boolean> {
    const { data, error } = await supabase!
      .from(HISTORY_TABLE)
      .select('id, image_path')
      .order('id', { ascending: true })
      .limit(1);

    if (error || !data || data.length === 0) return false;

    const oldest = data[0] as { id: number; image_path: string | null };
    if (oldest.image_path) {
      await supabase!.storage.from(BUCKET).remove([oldest.image_path]);
    }
    await supabase!.from(HISTORY_TABLE).delete().eq('id', oldest.id);
    return true;
  }

  async function pruneHistoryToLimit() {
    const { data, error } = await supabase!
      .from(HISTORY_TABLE)
      .select('id, image_path')
      .order('id', { ascending: false });

    if (error || !data) return;

    const excess = data.slice(HISTORY_LIMIT) as { id: number; image_path: string | null }[];
    for (const row of excess) {
      if (row.image_path) {
        await supabase!.storage.from(BUCKET).remove([row.image_path]);
      }
      await supabase!.from(HISTORY_TABLE).delete().eq('id', row.id);
    }
  }

  type HistoryEntry =
    | { content_type: 'text'; content: string }
    | { content_type: 'image'; file: File };

  async function tryInsertOnce(entry: HistoryEntry): Promise<{ ok: true } | { ok: false; error: unknown }> {
    let imagePath: string | null = null;

    if (entry.content_type === 'image') {
      imagePath = `${HISTORY_IMAGE_PREFIX}${crypto.randomUUID()}`;
      const { error: uploadError } = await supabase!.storage
        .from(BUCKET)
        .upload(imagePath, entry.file, { contentType: entry.file.type });
      if (uploadError) return { ok: false, error: uploadError };
    }

    const { error: insertError } = await supabase!.from(HISTORY_TABLE).insert({
      content_type: entry.content_type,
      content: entry.content_type === 'text' ? entry.content : null,
      image_path: imagePath,
      image_mime: entry.content_type === 'image' ? entry.file.type : null,
    });

    if (insertError) {
      // Upload already succeeded — without this, the object would orphan
      // permanently, since pruning only ever looks at DB rows to decide
      // what to delete from storage.
      if (imagePath) {
        await supabase!.storage.from(BUCKET).remove([imagePath]);
      }
      return { ok: false, error: insertError };
    }

    return { ok: true };
  }

  // Bounded retry: up to HISTORY_LIMIT insert attempts, evicting the single
  // oldest history item between failed attempts when the failure looks
  // capacity-related, stopping early if history runs out first. The
  // paste itself (secret_paste) has already been saved by the time this
  // runs, so a failure here never loses the user's actual paste — only
  // the history log entry can fail to record. Errors are swallowed here
  // deliberately; this must never throw into saveText/saveImage.
  async function insertHistory(entry: HistoryEntry) {
    try {
      for (let attempt = 1; attempt <= HISTORY_LIMIT; attempt++) {
        const result = await tryInsertOnce(entry);
        if (result.ok) {
          await pruneHistoryToLimit();
          await loadHistory();
          return;
        }
        if (attempt === HISTORY_LIMIT || !isQuotaLikeError(result.error)) {
          throw result.error;
        }
        const evicted = await evictOldestHistoryItem();
        if (!evicted) throw result.error;
      }
    } catch (err) {
      console.error('History append failed:', err);
    }
  }

  saveTextBtn.addEventListener('click', () => saveText(textInput.value));
  deleteBtn.addEventListener('click', clearCurrent);
  copyBtn.addEventListener('click', copyCurrent);
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) saveImage(file);
  });

  // Paste an image directly into the textarea with Ctrl/Cmd+V.
  textInput.addEventListener('paste', (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        e.preventDefault();
        const file = item.getAsFile();
        if (file) saveImage(file);
        return;
      }
    }
  });

  historyModalCopyBtn.addEventListener('click', () => {
    if (!activeHistoryItem) return;
    copyEntry(
      activeHistoryItem.content_type,
      activeHistoryItem.content,
      historyModalImageEl.src,
      setHistoryModalStatus
    );
  });
  historyModal.querySelector('[data-close-modal]')?.addEventListener('click', () => historyModal.close());
  historyModal.addEventListener('click', (e) => {
    if (e.target === historyModal) historyModal.close();
  });

  fileDownloadBtn.addEventListener('click', downloadCurrentFile);
  fileDeleteBtn.addEventListener('click', clearCurrentFile);
  fileUploadInput.addEventListener('change', () => {
    const file = fileUploadInput.files?.[0];
    if (file) uploadFile(file);
  });

  // Drag-and-drop onto the upload box.
  fileDropZone.addEventListener('dragover', (e: DragEvent) => {
    e.preventDefault();
    fileDropZone.classList.add('border-red-guards-dim');
  });
  fileDropZone.addEventListener('dragleave', () => {
    fileDropZone.classList.remove('border-red-guards-dim');
  });
  fileDropZone.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    fileDropZone.classList.remove('border-red-guards-dim');
    const file = e.dataTransfer?.files?.[0];
    if (file) uploadFile(file);
  });

  if (!supabaseConfigured) {
    configWarning.classList.remove('hidden');
    emptyState.textContent = 'Not configured.';
    fileEmptyState.textContent = 'Not configured.';
    historyEmpty.textContent = 'Not configured.';
  } else {
    loadCurrent();
    loadCurrentFile();
    loadHistory();

    // Live updates when someone else changes the paste. Re-fetch rather than
    // trusting payload.new: Postgres NOTIFY (which postgres_changes relies
    // on) caps payloads at 8000 bytes and silently drops larger fields, so
    // big pastes would show up empty/stale on other tabs otherwise.
    supabase!
      .channel('secret_paste_changes')
      .on(
        'postgres_changes',
        { event: 'UPDATE', schema: 'public', table: 'secret_paste', filter: `id=eq.${ROW_ID}` },
        () => loadCurrent()
      )
      .subscribe();

    // Live updates when someone else changes the uploaded file.
    supabase!
      .channel('secret_file_changes')
      .on(
        'postgres_changes',
        { event: 'UPDATE', schema: 'public', table: 'secret_file', filter: `id=eq.${ROW_ID}` },
        (payload) => renderFile(payload.new as FileRow)
      )
      .subscribe();

    // Live updates when someone else adds to or prunes history. Always
    // re-fetch (same reasoning as above) rather than trusting the payload —
    // also simpler here since inserts and deletes both just mean "re-fetch
    // the last 5," so one '*' listener covers both.
    supabase!
      .channel('paste_history_changes')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'paste_history' },
        () => loadHistory()
      )
      .subscribe();
  }
</script>
